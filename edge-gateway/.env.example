# LiteLLM API Keys (at least one required)
OPENAI_API_KEY=sk-your-openai-key
GROQ_API_KEY=gsk-your-groq-key
GOOGLE_API_KEY=your-google-api-key
NVIDIA_API_KEY=your-nvidia-key
MISTRAL_API_KEY=your-mistral-key

# LiteLLM Master Key (for proxy authentication)
LITELLM_MASTER_KEY=sk-master-key-change-in-production

# Database
DATABASE_URL=postgresql://user:pass@localhost:5432/litellm

# Cloudflare Worker Secrets (set with: wrangler secret put)
# LITELLM_API_KEY=your-litellm-key
# LITELLM_API_BASE=http://your-litellm-proxy:4000
