{
  "name": "scenario-1-fullstack",
  "version": "1.0.0",
  "description": "Full-stack Web App: Workers + Hono + Neon + Drizzle",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "tsc",
    "deploy": "wrangler publish --env=production",
    "migrate": "drizzle-kit generate && drizzle-kit push",
    "migrate:production": "drizzle-kit push --target-branch=main",
    "studio": "drizzle-kit studio",
    "test": "vitest run",
    "lint": "eslint src/"
  },
  "dependencies": {
    "hono": "^4.4.0",
    "drizzle-orm": "^0.31.0",
    "dotenv": "^16.4.0",
    "@neondatabase/serverless": "^0.9.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240806.0",
    "typescript": "^5.5.0",
    "drizzle-kit": "^0.22.0",
    "vitest": "^1.6.0",
    "wrangler": "^3.60.0",
    "eslint": "^8.57.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
